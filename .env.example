# --- Base de datos ---------------------------------------------------------
# Local (docker compose up -d). En producción (Neon): la URL "pooled" (con -pooler).
DATABASE_URL="postgresql://tienda:tienda@localhost:5433/tienda?schema=public"
# Solo producción: URL directa (sin -pooler) para que "prisma migrate deploy"
# no pase por el pooler. En local se deja vacía.
DIRECT_URL=""

# --- Sitio -----------------------------------------------------------------
# URL pública, usada para metadata, Open Graph, sitemap y URLs de retorno de pagos.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Almacenamiento de imágenes --------------------------------------------
# "local" guarda en disco (solo desarrollo). "cloudinary" para producción.
STORAGE_DRIVER="local"

# --- Autenticación (Auth.js) ---------------------------------------------
# Genera uno propio:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""
# Necesario fuera de Vercel (next start local, E2E). En Vercel no hace falta.
AUTH_TRUST_HOST=true

# --- Pagos: Payphone -------------------------------------------------------
# "mock" = pasarela simulada (/pago-simulado) para desarrollo y tests E2E.
# "live" = Payphone real (en su consola, la app puede estar en modo de pruebas).
# NUNCA usar "mock" en una tienda real: cualquiera podría aprobar sus pedidos.
PAYPHONE_MODE="mock"
# Token y Store ID de la app en https://appdeveloper.payphonetodoaldia.com
PAYPHONE_TOKEN=""
PAYPHONE_STORE_ID=""

# --- Cloudinary (producción) ------------------------------------------------
# Con STORAGE_DRIVER="cloudinary": fotos de productos (públicas) y comprobantes
# (tipo "authenticated", sin URL pública).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- Demo pública del portafolio ---------------------------------------------
# "true" muestra un aviso de tienda ficticia, publica las credenciales de prueba
# en el login, bloquea subidas y cambios sensibles en el panel, y habilita el
# reinicio nocturno de los datos (/api/cron/reset-demo, ver vercel.json).
NEXT_PUBLIC_DEMO_MODE="false"
# Secreto que Vercel Cron envía como "Authorization: Bearer ..." (mín. 16 caracteres)
CRON_SECRET=""
